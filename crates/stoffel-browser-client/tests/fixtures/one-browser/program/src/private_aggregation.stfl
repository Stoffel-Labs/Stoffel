# run-args: --client-input 0=0 --client-input 0=80 --client-input 0=2 --client-input 0=1 --client-input 1=2 --client-input 1=60 --client-input 1=1 --client-input 1=2 --client-input 2=0 --client-input 2=90 --client-input 2=3 --client-input 2=1 --expected-output-clients 3
#
# Hidden Edge private prediction aggregation.
#
# Per client private ClientStore slots:
#   0: predicted winner code, int64 in {0, 1, 2}; 0 = Team A, 1 = draw, 2 = Team B
#   1: confidence, int64 in [0, 100]
#   2: predicted Team A goals, int64
#   3: predicted Team B goals, int64
#
# Intended opened / client-delivered aggregate outputs, in order:
#   0: winning outcome code
#   1: Team A vote percentage, floor(count * 100 / n)
#   2: draw vote percentage, floor(count * 100 / n)
#   3: Team B vote percentage, floor(count * 100 / n)
#   4: average confidence, floor(sum / n)
#   5: disagreement percentage, floor((n - winning vote count) * 100 / n)
#   6: average Team A goals in hundredths, floor(sum * 100 / n)
#   7: average Team B goals in hundredths, floor(sum * 100 / n)
#
# Source-backed patterns: ClientStore and MpcOutput from mpc_client_private_score,
# secure comparison/select/equal from mpc_secure_comparison and mpc_select_minmax,
# division/mean shape from mpc_mean, and argmax shape from mpc_argmax.

def random_bit() -> Share:
  while True:
    var r = Share.random_field()
    var r_squared = Share.open_field(Share.mul(r, r))
    if Field.is_zero(r_squared):
      continue
    var r_prime_inv = Field.inverse(Field.sqrt(r_squared))
    var two_inv = Field.inverse(Field.from_int(2))
    var c = Share.mul_field(r, r_prime_inv)
    var a = Share.mul_field(Share.add_field(c, Field.one()), two_inv)
    return Share.retag(a, 1)

def pow2(i: int64) -> int64:
  var p = 1
  var k = 0
  while k < i:
    p = p * 2
    k = k + 1
  return p

def combine_bits(bits: list[Share], n: int64) -> Share:
  var acc = Share.mul_scalar(bits[0], 1)
  var i = 1
  while i < n:
    acc = Share.add(acc, Share.mul_scalar(bits[i], pow2(i)))
    i = i + 1
  return Share.retag(acc, 64)

# Shares of the bits of a in [0, 2^l) (low l usable).
def bit_decompose(a: Share, l: int64, kappa: int64) -> list[Share]:
  var m = l + kappa
  var n = m + 1
  var rbits: list[Share] = []
  var i = 0
  while i < m:
    rbits.append(random_bit())
    i = i + 1
  while i < n:
    rbits.append(Share.from_clear_int(0, 1))
    i = i + 1
  var r = combine_bits(rbits, n)
  var c = Share.open(Share.retag(Share.add(Share.retag(a, 64), r), 64))
  var abits: list[Share] = []
  var borrow = Share.from_clear_int(0, 1)
  i = 0
  while i < n:
    var ci = (c shr i) and 1
    var ri = rbits[i]
    var rb = Share.mul(ri, borrow)
    var xorrb = Share.sub(Share.add(ri, borrow), Share.mul_scalar(rb, 2))
    var ai = borrow
    var nb = borrow
    if ci == 0:
      ai = xorrb
      nb = Share.sub(Share.add(ri, borrow), rb)
    else:
      ai = Share.sub(Share.from_clear_int(1, 1), xorrb)
      nb = rb
    abits.append(Share.retag(ai, 1))
    borrow = Share.retag(nb, 1)
    i = i + 1
  return abits

# Secret-shared [a < b] for a, b in [0, 2^l): masked reveal + carry chain.
def less_than(a: Share, b: Share, l: int64, kappa: int64) -> Share:
  var z = Share.add_constant(Share.sub(Share.retag(a, 64), Share.retag(b, 64)), pow2(l))
  var rbits: list[Share] = []
  var i = 0
  while i < (l + 1):
    rbits.append(random_bit())
    i = i + 1
  var r_low = combine_bits(rbits, l + 1)
  var r_high = Share.retag(Share.random_int(kappa), 64)
  var r = Share.add(r_low, Share.mul_scalar(r_high, pow2(l + 1)))
  var c = Share.open(Share.retag(Share.add(Share.retag(z, 64), r), 64))
  var borrow = Share.from_clear_int(0, 1)
  i = 0
  while i < l:
    var ci = (c shr i) and 1
    var ri = rbits[i]
    var rb = Share.mul(ri, borrow)
    if ci == 0:
      borrow = Share.retag(Share.sub(Share.add(ri, borrow), rb), 1)
    else:
      borrow = Share.retag(rb, 1)
    i = i + 1
  var cl = (c shr l) and 1
  var rl = rbits[l]
  var rlb = Share.mul(rl, borrow)
  var zl = Share.sub(Share.add(rl, borrow), Share.mul_scalar(rlb, 2))
  if cl == 1:
    zl = Share.sub(Share.from_clear_int(1, 1), zl)
  return Share.sub(Share.from_clear_int(1, 1), Share.retag(zl, 1))

# Oblivious select: returns a if cond==1 else b.
def select(cond: Share, a: Share, b: Share) -> Share:
  var aa = Share.retag(a, 64)
  var bb = Share.retag(b, 64)
  var c = Share.retag(cond, 64)
  return Share.add(bb, Share.mul(c, Share.sub(aa, bb)))

# [a == b] = NOT(a<b) AND NOT(b<a)
def equal(a: Share, b: Share, l: int64, kappa: int64) -> Share:
  var nlt = Share.sub(Share.from_clear_int(1, 1), less_than(a, b, l, kappa))
  var ngt = Share.sub(Share.from_clear_int(1, 1), less_than(b, a, l, kappa))
  return Share.mul(nlt, ngt)

def divide(a: Share, d: Share, l: int64, kappa: int64) -> Share:
  var abits = bit_decompose(a, l, kappa)
  var qbits: list[Share] = []
  var t = 0
  while t < l:
    qbits.append(Share.from_clear_int(0, 1))
    t = t + 1
  var rem = Share.from_clear_int(0, 64)
  var i = l - 1
  while i >= 0:
    rem = Share.add(Share.mul_scalar(rem, 2), Share.retag(abits[i], 64))
    var ge = Share.sub(Share.from_clear_int(1, 1), less_than(rem, d, l + 1, kappa))
    rem = Share.sub(rem, Share.mul(Share.retag(ge, 64), Share.retag(d, 64)))
    qbits[i] = Share.retag(ge, 1)
    i = i - 1
  return combine_bits(qbits, l)

def sum_values(values: list[Share]) -> Share:
  var s = Share.from_clear_int(0, 64)
  var i = 0
  while i < len(values):
    s = Share.add(s, Share.retag(values[i], 64))
    i = i + 1
  return s

# Exact indicator for winner codes in {0, 1, 2}, avoiding bit-decomposition.
def outcome_indicator(winner: Share, code: int64) -> Share:
  var w = Share.retag(winner, 64)
  var inv_two = Field.inverse(Field.from_int(2))
  if code == 0:
    return Share.retag(Share.mul_field(Share.mul(Share.add_constant(w, -1), Share.add_constant(w, -2)), inv_two), 64)
  if code == 1:
    return Share.retag(Share.mul_scalar(Share.mul(w, Share.add_constant(w, -2)), -1), 64)
  return Share.retag(Share.mul_field(Share.mul(w, Share.add_constant(w, -1)), inv_two), 64)

# Count the private votes equal to the public outcome code.
def count_outcome(winners: list[Share], code: int64, l: int64, kappa: int64) -> Share:
  var count = Share.from_clear_int(0, 64)
  var i = 0
  while i < len(winners):
    count = Share.add(count, outcome_indicator(winners[i], code))
    i = i + 1
  return count

def main() -> int64:
  # l=16 covers the supported room sizes and score/confidence sums. Increase this
  # before accepting rooms where any aggregate can reach 2^16.
  var l = 16
  # kappa=8 keeps local development runs quick. Choose the deployed value for
  # the selected backend and security requirements.
  var kappa = 8
  # The checked-in source uses a three-participant default.
  # The local MPC runner generates a temporary artifact with
  # this value replaced by the room's current participant count.
  var n = 1

  var winners: list[Share] = []
  var confidences: list[Share] = []
  var team_a_goals: list[Share] = []
  var team_b_goals: list[Share] = []

  var i = 0
  while i < n:
    var predicted_winner: secret int64 = ClientStore.take_share(i, 0)
    var confidence: secret int64 = ClientStore.take_share(i, 1)
    var predicted_team_a_goals: secret int64 = ClientStore.take_share(i, 2)
    var predicted_team_b_goals: secret int64 = ClientStore.take_share(i, 3)

    winners.append(predicted_winner)
    confidences.append(confidence)
    team_a_goals.append(predicted_team_a_goals)
    team_b_goals.append(predicted_team_b_goals)
    i = i + 1

  var team_a_votes = count_outcome(winners, 0, l, kappa)
  var draw_votes = count_outcome(winners, 1, l, kappa)
  var team_b_votes = count_outcome(winners, 2, l, kappa)

  var opened_team_a_votes = Share.open(Share.retag(team_a_votes, 64))
  var opened_draw_votes = Share.open(Share.retag(draw_votes, 64))
  var opened_team_b_votes = Share.open(Share.retag(team_b_votes, 64))
  var opened_confidence_sum = Share.open(sum_values(confidences))
  var opened_team_a_goal_sum = Share.open(sum_values(team_a_goals))
  var opened_team_b_goal_sum = Share.open(sum_values(team_b_goals))

  var opened_winner = 0
  var opened_winning_vote_count = opened_team_a_votes
  if opened_draw_votes > opened_winning_vote_count:
    opened_winner = 1
    opened_winning_vote_count = opened_draw_votes
  if opened_team_b_votes > opened_winning_vote_count:
    opened_winner = 2
    opened_winning_vote_count = opened_team_b_votes

  var opened_team_a_percentage = (opened_team_a_votes * 100) / n
  var opened_draw_percentage = (opened_draw_votes * 100) / n
  var opened_team_b_percentage = (opened_team_b_votes * 100) / n
  var opened_avg_confidence = opened_confidence_sum / n
  var opened_disagreement = ((n - opened_winning_vote_count) * 100) / n
  var opened_avg_team_a_goals = (opened_team_a_goal_sum * 100) / n
  var opened_avg_team_b_goals = (opened_team_b_goal_sum * 100) / n

  var outputs: list[Share] = []
  outputs.append(Share.from_clear_int(opened_winner, 64))
  outputs.append(Share.from_clear_int(opened_team_a_percentage, 64))
  outputs.append(Share.from_clear_int(opened_draw_percentage, 64))
  outputs.append(Share.from_clear_int(opened_team_b_percentage, 64))
  outputs.append(Share.from_clear_int(opened_avg_confidence, 64))
  outputs.append(Share.from_clear_int(opened_disagreement, 64))
  outputs.append(Share.from_clear_int(opened_avg_team_a_goals, 64))
  outputs.append(Share.from_clear_int(opened_avg_team_b_goals, 64))

  if Mpc.has_capability("client-output"):
    MpcOutput.send_to_client(0, outputs)

  # Aggregate counts and sums are opened; participant-level values remain private.
  return opened_winner
